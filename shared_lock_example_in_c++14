#include <iostream>
#include <thread>
#include <shared_mutex>
#include <vector>
#include <chrono>

class Database
{
private:
    int data = 100;
    mutable std::shared_timed_mutex mutex; // C++14

public:
    void read(int id) const
    {
        std::shared_lock<std::shared_timed_mutex> lock(mutex);

        std::cout << "Reader " << id
                  << " reads value = " << data << std::endl;

        std::this_thread::sleep_for(std::chrono::seconds(1));
    }

    void write(int value)
    {
        std::unique_lock<std::shared_timed_mutex> lock(mutex);

        std::cout << "Writer updating value to "
                  << value << std::endl;

        data = value;

        std::this_thread::sleep_for(std::chrono::seconds(2));
    }
};

int main()
{
    Database db;

    std::thread t1(&Database::read, &db, 1);
    std::thread t2(&Database::read, &db, 2);
    std::thread t3(&Database::read, &db, 3);

    std::this_thread::sleep_for(std::chrono::milliseconds(100));

    std::thread writer(&Database::write, &db, 500);

    t1.join();
    t2.join();
    t3.join();
    writer.join();

    return 0;
}
