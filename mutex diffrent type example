// basic  
#include <iostream>
#include <thread>
#include <mutex>

std::mutex mtx;

void print(int id)
{
    std::lock_guard<std::mutex> lock(mtx);

    std::cout << "Thread " << id << std::endl;
}

int main()
{
    std::thread t1(print, 1);
    std::thread t2(print, 2);

    t1.join();
    t2.join();
}


// recuresiv mutex 
#include <iostream>
#include <mutex>

class Counter
{
    std::recursive_mutex mtx;

public:
    void func(int n)
    {
        std::lock_guard<std::recursive_mutex> lock(mtx);

        std::cout << n << std::endl;

        if(n > 0)
            func(n - 1); // Safe
    }
};

int main()
{
    Counter c;
    c.func(3);
}

// timed_mutex 
#include <iostream>
#include <thread>
#include <mutex>
#include <chrono>

std::timed_mutex mtx;

void worker()
{
    if(mtx.try_lock_for(std::chrono::seconds(2)))
    {
        std::cout << "Lock acquired\n";
        mtx.unlock();
    }
    else
    {
        std::cout << "Timeout\n";
    }
}

int main()
{
    mtx.lock();

    std::thread t(worker);

    std::this_thread::sleep_for(std::chrono::seconds(3));

    mtx.unlock();

    t.join();
}
//try_lock_for 
#include <iostream>
#include <thread>
#include <mutex>
#include <chrono>

std::timed_mutex mtx;

void worker()
{
    std::cout << "Worker: Trying to acquire lock...\n";

    if (mtx.try_lock_for(std::chrono::seconds(2)))
    {
        std::cout << "Worker: Lock acquired.\n";
        mtx.unlock();
    }
    else
    {
        std::cout << "Worker: Timed out waiting for lock.\n";
    }
}

//try_lock_until 
#include <iostream>
#include <thread>
#include <mutex>
#include <chrono>

std::timed_mutex mtx;

void worker()
{
    auto timeout =
        std::chrono::steady_clock::now() +
        std::chrono::seconds(3);

    if (mtx.try_lock_until(timeout))
    {
        std::cout << "Lock acquired\n";
        mtx.unlock();
    }
    else
    {
        std::cout << "Timeout\n";
    }
}

int main()
{
    mtx.lock();

    std::thread t(worker);

    std::this_thread::sleep_for(std::chrono::seconds(5));

    mtx.unlock();

    t.join();
}


int main()
{
    mtx.lock();   // Main thread acquires lock

    std::thread t(worker);

    std::this_thread::sleep_for(std::chrono::seconds(5));

    mtx.unlock();

    t.join();
}


