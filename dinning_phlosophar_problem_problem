  #include <iostream>
#include <thread>
#include <mutex>
#include <vector>
#include <chrono>

const int N = 5;

std::mutex forks[N];

void philosopher(int id)
{
    int left = id;
    int right = (id + 1) % N;

    // Always lock the smaller fork number first
    int first = std::min(left, right);
    int second = std::max(left, right);

    while (true)
    {
        std::cout << "Philosopher " << id << " is thinking\n";
        std::this_thread::sleep_for(std::chrono::milliseconds(500));

        {
            std::lock_guard<std::mutex> lock1(forks[first]);
            std::lock_guard<std::mutex> lock2(forks[second]);

            std::cout << "Philosopher " << id << " is eating\n";
            std::this_thread::sleep_for(std::chrono::seconds(1));
        } // Both forks released automatically

        break;
    }
}

int main()
{
    std::vector<std::thread> philosophers;

    for (int i = 0; i < N; i++)
        philosophers.emplace_back(philosopher, i);

    for (auto &t : philosophers)
        t.join();
}
